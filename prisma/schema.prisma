// Prisma ORM v6 schema for WAYRO AI.
// Provider: PostgreSQL. Generate with `npm run db:generate`.
// Local UI demo does not require a live database; see README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  profile         StudentProfile?
  applications    Application[]
  savedItems      SavedOpportunity[]
  progressEntries ProgressEntry[]
  learningTasks   LearningTask[]
  proposals       HackathonProposal[]
  settings        UserSettings?
  activity        ActivityEvent[]

  @@map("users")
}

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  bio                String?  @db.Text
  institution        String?
  graduationYear     Int?
  fieldOfStudy       String?
  location           String?
  remotePreference   String?
  weeklyHours        Int?
  goals              String[]
  targetRoles        String?
  interests          String[]
  preferredTypes     String[]
  portfolioUrl       String?
  githubUrl          String?
  linkedinUrl        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills   Skill[]
  projects Project[]

  @@map("student_profiles")
}

model Skill {
  id        String     @id @default(cuid())
  profileId String
  name      String
  category  String     @default("general")
  level     SkillLevel
  createdAt DateTime   @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("skills")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  description String?  @db.Text
  url         String?
  skills      String[]
  createdAt   DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model Opportunity {
  id             String             @id @default(cuid())
  title          String
  type           OpportunityType
  organization   String
  description    String             @db.Text
  requirements   String[]
  skills         String[]
  deadline       DateTime?
  applicationUrl String
  location       String?
  remote         Boolean            @default(false)
  eligibility    String[]
  experience     String?
  status         OpportunityStatus  @default(OPEN)
  trustScore     Float?
  sourceUrl      String?
  isDemo         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  applications Application[]
  savedBy      SavedOpportunity[]

  @@index([type, status])
  @@index([deadline])
  @@map("opportunities")
}

enum OpportunityType {
  INTERNSHIP
  JOB
  HACKATHON
  SCHOLARSHIP
  FELLOWSHIP
  RESEARCH
  COMPETITION
  COURSE
}

enum OpportunityStatus {
  OPEN
  CLOSING_SOON
  CLOSED
}

model SavedOpportunity {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@map("saved_opportunities")
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(INTERESTED)
  notes         String?           @db.Text
  appliedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId, status])
  @@map("applications")
}

enum ApplicationStatus {
  INTERESTED
  PREPARING
  APPLIED
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
}

model ProgressEntry {
  id          String   @id @default(cuid())
  userId      String
  category    String
  title       String
  description String?
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("progress_entries")
}

model LearningResource {
  id            String       @id @default(cuid())
  title         String
  type          ResourceType
  provider      String
  url           String
  durationHours Float?
  isFree        Boolean      @default(true)
  skills        String[]
  isDemo        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  tasks LearningTask[]

  @@map("learning_resources")
}

enum ResourceType {
  COURSE
  CERTIFICATION
  ARTICLE
  PROJECT
  VIDEO
  DOCS
}

model LearningTask {
  id         String           @id @default(cuid())
  userId     String
  resourceId String?
  skill      String
  title      String
  status     LearningStatus   @default(NOT_STARTED)
  relatedOpportunityId String?
  updatedAt  DateTime         @updatedAt
  createdAt  DateTime         @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource LearningResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("learning_tasks")
}

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model HackathonProposal {
  id                 String   @id @default(cuid())
  userId             String
  title              String
  domain             String
  challengeName      String?
  projectType        String
  problem            String   @db.Text
  targetUsers        String   @db.Text
  existingApproaches String   @db.Text
  gaps               String[]
  hypothesisGaps     String[]
  proposedInnovation String   @db.Text
  architecture       String   @db.Text
  mvpScope           String   @db.Text
  feasibility        String   @db.Text
  risks              String[]
  evaluationMetrics  String[]
  demoStrategy       String   @db.Text
  limitations        String   @db.Text
  isPreliminary      Boolean  @default(true)
  researchAvailable  Boolean  @default(false)
  selected           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("hackathon_proposals")
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  deadlineReminders     Boolean  @default(true)
  matchAlerts           Boolean  @default(false)
  reducedMotion         Boolean  @default(false)
  largeText             Boolean  @default(false)
  inAppRemindersEnabled Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  href      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity_events")
}
