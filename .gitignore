# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Testing ──────────────────────────────────────────────────
/coverage
/test-results
/playwright-report

# ── Next.js ──────────────────────────────────────────────────
/.next/
/out/

# ── Production build ─────────────────────────────────────────
/build

# ── Secrets and environment variables ────────────────────────
# .env.example is safe to commit; all others are NOT
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ── Misc ─────────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db
/.data/

# ── Debug logs ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Prisma ───────────────────────────────────────────────────
# Never commit local SQLite dev databases
*.db
*.db-journal
/prisma/*.db

# ── Vercel ───────────────────────────────────────────────────
.vercel

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── IDE ──────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
