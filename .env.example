# Copy to .env.local for Next.js. Prisma CLI also reads .env.
# This file contains placeholders only; never commit real credentials.

NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_PROVIDER=mock

# Optional PostgreSQL connection for Prisma commands only.
# WAYRO's current API routes use per-student local JSON files, not PostgreSQL.
# DATABASE_URL=postgresql://user:password@localhost:5432/wayro_dev?schema=public

# Required for student signup and signed sessions. Use a randomly generated secret of at least 32 characters.
# AUTH_SECRET=

# Optional persistent data location. Defaults to <project>/.data.
# WAYRO_DATA_DIR=

# No external AI provider is currently implemented.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
